{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heritage-short/storyboard.schema.json",
  "title": "Heritage Short storyboard: the contract between every stage",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "logline", "language", "audience", "intent", "style", "voice", "music", "shots"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "logline": {"type": "string", "minLength": 10, "description": "One sentence that sums up the story."},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$", "description": "BCP-47 code of the narration, e.g. am, om, ti, en."},
    "audience": {"type": "string", "minLength": 10},
    "intent": {"type": "string", "minLength": 10, "description": "What the audience should feel or understand at the end."},
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_block", "character", "seed"],
      "properties": {
        "style_block": {"type": "string", "minLength": 10, "description": "Appended to every image prompt so the look never drifts."},
        "character": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "description"],
          "properties": {
            "name": {"type": "string"},
            "description": {"type": "string", "minLength": 10, "description": "Appended to every prompt that shows the character."},
            "reference_image": {"type": "string", "description": "Path of the approved golden reference, once chosen."}
          }
        },
        "seed": {"type": "integer", "minimum": 0}
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "style_instruction"],
      "properties": {
        "name": {"type": "string", "description": "Prebuilt TTS voice name."},
        "style_instruction": {"type": "string", "description": "e.g. Read slowly and warmly, like an elder telling a family story."}
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption", "bpm", "cues"],
      "properties": {
        "caption": {"type": "string", "minLength": 10},
        "bpm": {"type": "integer", "minimum": 40, "maximum": 180},
        "key": {"type": "string"},
        "instrumental": {"type": "boolean", "default": true},
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at_shot", "description"],
            "properties": {
              "at_shot": {"type": "string", "pattern": "^s[0-9]{2}$"},
              "description": {"type": "string"}
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "duration", "reason", "shot_size", "image_prompt", "motion", "narration", "subtitle_en"],
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]{2}$"},
          "duration": {"type": "number", "minimum": 3, "maximum": 12},
          "reason": {"type": "string", "minLength": 10, "description": "Why this shot exists, in one sentence."},
          "shot_size": {"enum": ["extreme-wide", "wide", "medium", "medium-close-up", "close-up", "extreme-close-up", "insert"]},
          "shows_character": {"type": "boolean", "default": true},
          "image_prompt": {"type": "string", "minLength": 10},
          "motion": {"enum": ["i2v", "kenburns", "still"], "description": "i2v = Wan 2.2 clip; kenburns = FFmpeg pan/zoom fallback."},
          "motion_prompt": {"type": "string", "description": "Only the movement and camera; the keyframe already holds the subject."},
          "narration": {"type": "string", "description": "The line spoken over this shot, in the film's language. Empty for a silent beat."},
          "subtitle_en": {"type": "string"},
          "seed": {"type": "integer", "minimum": 0}
        },
        "allOf": [{"if": {"properties": {"motion": {"const": "i2v"}}}, "then": {"required": ["motion_prompt"]}}]
      }
    }
  }
}
