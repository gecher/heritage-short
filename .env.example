# Copy to .env and fill in. .env is git-ignored.
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
# Model ids change often: set them to what your accounts actually list (python -m pipeline smoke prints them).
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TEXT_FALLBACKS=gemini-3.7-flash,gemini-flash-latest,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
